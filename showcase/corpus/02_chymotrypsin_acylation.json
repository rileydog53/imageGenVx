{
  "archetype": "mechanism_cartoon",
  "tiers": [
    {
      "id": "title",
      "role": "title",
      "height_frac": 0.14,
      "label": "Chymotrypsin Acylation by the Catalytic Triad",
      "subtitle": "Ser195 nucleophilic attack on the scissile peptide carbonyl"
    },
    {
      "id": "mech",
      "role": "scene_row",
      "height_frac": 0.6,
      "style": { "band_fill": "#F1F4F0" },
      "rails": [ { "name": "mid", "axis": "y", "at": 0.5 } ],
      "scenes": [
        {
          "id": "s1",
          "badge": "1",
          "label": "Substrate bound;\nHis57 polarises Ser195",
          "slots": [
            {
              "id": "sub",
              "kind": "molecule",
              "label": "peptide substrate",
              "style": {
                "smiles": "CC(=O)NC[C:1](=[O:2])NC",
                "anchor_names": { "1": "carbonylC", "2": "carbonylO" }
              }
            },
            { "id": "ser", "kind": "residue", "label": "Ser195",
              "style": { "residue": "ser", "label_font_color": "#2E7D32" } },
            { "id": "his", "kind": "residue", "label": "His57",
              "style": { "residue": "his", "label_font_color": "#1565C0" } }
          ],
          "attach": [
            { "child": "ser", "parent": "sub", "edge": "top", "offset": [0, -34] },
            { "child": "his", "parent": "sub", "edge": "bottom", "offset": [0, 30] }
          ],
          "connect": [
            { "from_anchor": "his.a1", "to_anchor": "ser.a1", "type": "hbond", "label": "H-bond" }
          ]
        },
        {
          "id": "s2",
          "badge": "2",
          "label": "Nucleophilic attack\nby Ser195 -OH",
          "slots": [
            {
              "id": "sub",
              "kind": "molecule",
              "label": "peptide substrate",
              "style": {
                "smiles": "CC(=O)NC[C:1](=[O:2])NC",
                "anchor_names": { "1": "carbonylC", "2": "carbonylO" }
              }
            },
            { "id": "ser", "kind": "residue", "label": "Ser195",
              "style": { "residue": "ser", "label_font_color": "#2E7D32" } },
            { "id": "his", "kind": "residue", "label": "His57",
              "style": { "residue": "his", "label_font_color": "#1565C0" } }
          ],
          "attach": [
            { "child": "ser", "parent": "sub", "edge": "top", "offset": [0, -34] },
            { "child": "his", "parent": "sub", "edge": "bottom", "offset": [0, 30] }
          ],
          "connect": [
            { "from_anchor": "ser.lp_a1", "to_anchor": "sub.carbonylC",
              "type": "curly", "style": { "curl": "cw", "bow": 22 } },
            { "from_anchor": "sub.bond_carbonylC_carbonylO", "to_anchor": "sub.carbonylO",
              "type": "curly", "style": { "arc": "s", "bow": 12 } }
          ]
        },
        {
          "id": "s3",
          "badge": "3",
          "label": "Tetrahedral\nintermediate",
          "slots": [
            {
              "id": "ti",
              "kind": "molecule",
              "label": "oxyanion intermediate",
              "style": {
                "smiles": "CC(=O)NC[C:1]([O:2])(NC)O",
                "anchor_names": { "1": "tetC", "2": "oxyanionO" },
                "chem_atom_O": "#C0392B"
              }
            },
            { "id": "ser", "kind": "residue", "label": "Ser195",
              "style": { "residue": "ser", "label_font_color": "#2E7D32" } },
            { "id": "his", "kind": "residue", "label": "His57+",
              "style": { "residue": "his", "label_font_color": "#1565C0" } }
          ],
          "attach": [
            { "child": "ser", "parent": "ti", "edge": "top", "offset": [0, -34] },
            { "child": "his", "parent": "ti", "edge": "bottom", "offset": [0, 30] }
          ],
          "connect": [
            { "from_anchor": "ser.a1", "to_anchor": "ti.tetC", "type": "dashed", "label": "new bond" }
          ]
        }
      ],
      "transitions": [
        { "from_ref": "s1@right", "to_ref": "s2@left", "type": "transition", "on_rail": "mid" },
        { "from_ref": "s2@right", "to_ref": "s3@left", "type": "transition", "on_rail": "mid" }
      ]
    },
    {
      "id": "sum",
      "role": "scene_row",
      "height_frac": 0.26,
      "style": { "band_fill": "#EAF1EA" },
      "scenes": [
        {
          "id": "overview",
          "label": "Overall reaction",
          "slots": [
            { "id": "pep", "kind": "glyph", "label": "peptide", "style": { "glyph": "protein_blob", "blob_fill": "#9CB89C" } },
            { "id": "enz", "kind": "glyph", "label": "chymotrypsin", "style": { "glyph": "protein_blob", "blob_fill": "#7FA0C0" } },
            { "id": "frag", "kind": "glyph", "label": "cleaved fragments", "style": { "glyph": "pg_cluster", "pg_fill": "#4A7ABF" } }
          ],
          "attach": [
            { "child": "enz", "parent": "pep", "edge": "right", "offset": [70, 0] },
            { "child": "frag", "parent": "enz", "edge": "right", "offset": [70, 0] }
          ],
          "connect": [
            { "from_anchor": "pep.center", "to_anchor": "enz.center", "type": "transition" },
            { "from_anchor": "enz.center", "to_anchor": "frag.center", "type": "transition", "label": "hydrolysis" }
          ]
        }
      ]
    }
  ]
}
